<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPay Auto-Import Listener"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnEnable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable Notification Access"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnRebind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Force Restart Listener"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your User ID (from web dashboard):"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste your User ID here"
        android:inputType="text"
        android:singleLine="true"
        android:padding="12dp"
        android:background="#F4F4F4"
        android:textSize="14sp"
        android:typeface="monospace"
        android:layout_marginBottom="4dp"/>

    <Button
        android:id="@+id/btnSaveUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save User ID"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Service Logs:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="Waiting for service to start..."/>
    </ScrollView>

</LinearLayout>
